# Export these variables in your shell before running the opt-in two_providers example.
# Use distinct providers on the same Solana cluster with identical subscription semantics.
YELLOWSTONE_A_URL=
YELLOWSTONE_A_TOKEN=
YELLOWSTONE_B_URL=
YELLOWSTONE_B_TOKEN=
RECONCILE_MAX_BLOCKS=100
RECONCILE_MAX_SECONDS=300
# Labels document operator identity; different labels alone do not prove independence.
YELLOWSTONE_A_NAME=
YELLOWSTONE_B_NAME=
